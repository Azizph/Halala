{
  "run": {
    "data": "data/smoke_parallel.jsonl",
    "out_dir": "runs",
    "cache_path": "cache/calls.sqlite",
    "seed": 13,
    "workers": 4,
    "limit_groups": 2,
    "split_fractions": {
      "train": 0.5,
      "calib": 0.25,
      "test": 0.25
    },
    "name": "api_ollama"
  },
  "cost": {
    "primary": "flops"
  },
  "models": {
    "small": {
      "backend": "openai",
      "name": "qwen2.5:1.5b",
      "params_b": 1.5,
      "max_tokens": 64,
      "usd_per_mtok_in": 0.0,
      "usd_per_mtok_out": 0.0,
      "mock_accuracy": {
        "en": 0.92,
        "msa": 0.88,
        "dialect": 0.72,
        "arabizi": 0.45,
        "mixed": 0.62
      },
      "base_url": "http://localhost:11434/v1",
      "api_key_env": "HALALA_API_KEY"
    },
    "large": {
      "backend": "openai",
      "name": "qwen2.5:7b",
      "params_b": 7,
      "max_tokens": 64,
      "usd_per_mtok_in": 0.0,
      "usd_per_mtok_out": 0.0,
      "mock_accuracy": {
        "en": 0.97,
        "msa": 0.97,
        "dialect": 0.95,
        "arabizi": 0.9,
        "mixed": 0.93
      },
      "base_url": "http://localhost:11434/v1",
      "api_key_env": "HALALA_API_KEY"
    }
  },
  "cascade": {
    "samples": 5,
    "temperature": 0.7,
    "shared_prefill": true,
    "normalize": true,
    "arabizi": "model",
    "cache": true,
    "cache_similarity": 0.92
  },
  "router": {
    "model": "hgb"
  },
  "calibrate": {
    "epsilon": 0.05,
    "delta": 0.1,
    "min_group_size": 50,
    "small_group_policy": "escalate"
  }
}
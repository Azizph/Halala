{
  "run": {
    "data": "data/synthetic_arith.jsonl",
    "out_dir": "runs",
    "cache_path": "cache/calls.sqlite",
    "seed": 13,
    "workers": 1,
    "limit_groups": 0,
    "split_fractions": {
      "train": 0.5,
      "calib": 0.25,
      "test": 0.25
    },
    "name": "no_rescue"
  },
  "cost": {
    "primary": "flops"
  },
  "models": {
    "small": {
      "backend": "mock",
      "name": "mock-small",
      "params_b": 7,
      "max_tokens": 64,
      "usd_per_mtok_in": 0.0,
      "usd_per_mtok_out": 0.0,
      "mock_accuracy": {
        "en": 0.92,
        "msa": 0.88,
        "dialect": 0.72,
        "arabizi": 0.45,
        "mixed": 0.62
      }
    },
    "large": {
      "backend": "mock",
      "name": "mock-large",
      "params_b": 34,
      "max_tokens": 64,
      "usd_per_mtok_in": 0.0,
      "usd_per_mtok_out": 0.0,
      "mock_accuracy": {
        "en": 0.97,
        "msa": 0.97,
        "dialect": 0.95,
        "arabizi": 0.9,
        "mixed": 0.93
      }
    }
  },
  "cascade": {
    "samples": 5,
    "temperature": 0.7,
    "shared_prefill": true,
    "normalize": false,
    "arabizi": "none",
    "cache": true,
    "cache_similarity": 0.92
  },
  "router": {
    "model": "hgb"
  },
  "calibrate": {
    "epsilon": 0.05,
    "delta": 0.1,
    "min_group_size": 50,
    "small_group_policy": "escalate"
  }
}